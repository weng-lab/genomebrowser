{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"],
  "plugins": ["unicorn", "typescript", "oxc", "react", "jsx-a11y", "vitest", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "no-debugger": "error",
    "no-async-promise-executor": "error",
    "no-unsafe-finally": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "vitest/no-focused-tests": "error",
    "no-unused-vars": "error",
    "react/exhaustive-deps": "error",
    "typescript/await-thenable": "off",
    "typescript/no-array-delete": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-floating-promises": "off",
    "typescript/no-for-in-array": "off",
    "typescript/no-implied-eval": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unsafe-unary-minus": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/prefer-string-starts-ends-with": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      "files": ["packages/core/src/**"],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@weng-lab/genomebrowser-standalone",
                  "@weng-lab/genomebrowser-standalone/**",
                  "@weng-lab/genomebrowser-playground",
                  "@weng-lab/genomebrowser-playground/**",
                  "@weng-lab/render-probe",
                  "@weng-lab/render-probe/**",
                  "@weng-lab/genomic-reader",
                  "@weng-lab/genomic-reader/**",
                  "@weng-lab/genomebrowser-tracks",
                  "@weng-lab/genomebrowser-tracks/**",
                  "@weng-lab/genomebrowser-ui",
                  "@weng-lab/genomebrowser-ui/**"
                ],
                "message": "Core and reader are independent foundations; core must not depend on reader, higher-level packages, applications, or test utilities."
              },
              {
                "regex": "(?:^|/)apps/|^(?:\\.\\./)+(?:packages/)?(?:reader|tracks|ui|render-probe)(?:/|$)",
                "message": "Do not bypass package ownership with relative imports."
              },
              {
                "regex": "^@weng-lab/[^/]+/(?:src|dist)(?:/|$)|^(?:\\.\\./)+(?:packages/)?(?:reader|tracks|ui)/(?:src|dist)(?:/|$)",
                "message": "Import other libraries through their public package exports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/reader/src/**"],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@weng-lab/genomebrowser-standalone",
                  "@weng-lab/genomebrowser-standalone/**",
                  "@weng-lab/genomebrowser-playground",
                  "@weng-lab/genomebrowser-playground/**",
                  "@weng-lab/render-probe",
                  "@weng-lab/render-probe/**",
                  "@weng-lab/genomebrowser",
                  "@weng-lab/genomebrowser/**",
                  "@weng-lab/genomebrowser-tracks",
                  "@weng-lab/genomebrowser-tracks/**",
                  "@weng-lab/genomebrowser-ui",
                  "@weng-lab/genomebrowser-ui/**",
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**"
                ],
                "message": "Reader source must not depend on higher-level packages, applications, or test utilities."
              },
              {
                "regex": "(?:^|/)apps/|^(?:\\.\\./)+(?:packages/)?(?:core|tracks|ui|render-probe)(?:/|$)",
                "message": "Do not bypass package ownership with relative imports."
              },
              {
                "regex": "^@weng-lab/[^/]+/(?:src|dist)(?:/|$)|^(?:\\.\\./)+(?:packages/)?(?:core|tracks|ui)/(?:src|dist)(?:/|$)",
                "message": "Import other libraries through their public package exports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/tracks/src/**"],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@weng-lab/genomebrowser-standalone",
                  "@weng-lab/genomebrowser-standalone/**",
                  "@weng-lab/genomebrowser-playground",
                  "@weng-lab/genomebrowser-playground/**",
                  "@weng-lab/render-probe",
                  "@weng-lab/render-probe/**",
                  "@weng-lab/genomebrowser-ui",
                  "@weng-lab/genomebrowser-ui/**"
                ],
                "message": "Tracks source must not depend on higher-level packages, applications, or test utilities."
              },
              {
                "regex": "(?:^|/)apps/|^(?:\\.\\./)+(?:packages/)?(?:ui|render-probe)(?:/|$)",
                "message": "Do not bypass package ownership with relative imports."
              },
              {
                "regex": "^@weng-lab/[^/]+/(?:src|dist)(?:/|$)|^(?:\\.\\./)+(?:packages/)?(?:core|reader|ui)/(?:src|dist)(?:/|$)",
                "message": "Import other libraries through their public package exports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/src/**"],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@weng-lab/genomebrowser-standalone",
                  "@weng-lab/genomebrowser-standalone/**",
                  "@weng-lab/genomebrowser-playground",
                  "@weng-lab/genomebrowser-playground/**",
                  "@weng-lab/render-probe",
                  "@weng-lab/render-probe/**"
                ],
                "message": "UI source must not depend on higher-level packages, applications, or test utilities."
              },
              {
                "regex": "(?:^|/)apps/|^(?:\\.\\./)+(?:packages/)?(?:render-probe)(?:/|$)",
                "message": "Do not bypass package ownership with relative imports."
              },
              {
                "regex": "^@weng-lab/[^/]+/(?:src|dist)(?:/|$)|^(?:\\.\\./)+(?:packages/)?(?:core|reader|tracks)/(?:src|dist)(?:/|$)",
                "message": "Import other libraries through their public package exports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)apps/server/|^(?:\\.\\./)+server/src(?:/|$)|^@weng-lab/mcp(?:/|$)",
                "message": "Web and MCP communicate through contracts, never through each other's source."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)apps/web/|^(?:\\.\\./)+web/(?:app|features|composition|shared)(?:/|$)|^@weng-lab/web(?:/|$)",
                "message": "Web and MCP communicate through contracts, never through each other's source."
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "drizzle-kit",
                  "drizzle-kit/**",
                  "pg",
                  "pg/**"
                ],
                "message": "The MCP server delivers commands; session persistence belongs in the web app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)apps/server/|^(?:\\.\\./)+server/src(?:/|$)|^@weng-lab/mcp(?:/|$)",
                "message": "Web and MCP communicate through contracts, never through each other's source."
              },
              {
                "regex": "(?:^|/)(?:app|composition)(?:/|$)",
                "message": "Features expose capabilities to routes and composition; they must not import those callers."
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "drizzle-kit",
                  "drizzle-kit/**",
                  "pg",
                  "pg/**"
                ],
                "message": "Database access belongs in feature server modules and server composition."
              }
            ]
          }
        ]
      },
      "excludeFiles": ["apps/web/features/**/server/**", "**/*.test.*", "**/*.spec.*"]
    },
    {
      "files": ["apps/web/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)apps/server/|^(?:\\.\\./)+server/src(?:/|$)|^@weng-lab/mcp(?:/|$)",
                "message": "Web and MCP communicate through contracts, never through each other's source."
              },
              {
                "regex": "(?:^|/)(?:features|app|composition)(?:/|$)",
                "message": "Shared presentation must not depend on product features, routes, or composition."
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "drizzle-kit",
                  "drizzle-kit/**",
                  "pg",
                  "pg/**"
                ],
                "message": "Database access belongs in feature server modules and server composition."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/shared/workspace/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@weng-lab/*"],
                "message": "Workspace components own presentation; product behavior belongs in features."
              },
              {
                "regex": "(?:^|/)(?:app|session|commands|server)(?:/|$)",
                "message": "Keep the workspace shell independent of domain pages, session state, and server implementation."
              },
              {
                "regex": "(?:^|/)apps/server/|^(?:\\.\\./)+server/src(?:/|$)|^@weng-lab/mcp(?:/|$)",
                "message": "Web and MCP communicate through contracts, never through each other's source."
              },
              {
                "regex": "(?:^|/)(?:features|composition)(?:/|$)",
                "message": "Keep workspace presentation independent of product features and composition."
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "drizzle-kit",
                  "drizzle-kit/**",
                  "pg",
                  "pg/**"
                ],
                "message": "Database access belongs in feature server modules and server composition."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/contracts/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!zod", "!zod/**", "!./**"],
                "message": "Contracts contain protocol schemas and types; only schema dependencies belong here."
              },
              {
                "regex": "(?:^|/)(?:apps|packages|web|server)(?:/|$)",
                "message": "Contracts must not import app implementations or browser libraries."
              },
              {
                "regex": "^\\.\\./",
                "message": "Keep contract schemas within contracts/src; parent imports escape the schema owner."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/{app,composition,features,shared}/**",
        "apps/server/src/**",
        "apps/contracts/src/**"
      ],
      "rules": {
        "import/no-cycle": "error"
      }
    },
    {
      "files": ["apps/web/**", "apps/server/**"],
      "rules": {
        "typescript/no-floating-promises": [
          "error",
          {
            "ignoreVoid": false
          }
        ],
        "typescript/no-misused-promises": "error"
      }
    },
    {
      "files": ["apps/web/app/**", "apps/web/composition/**"],
      "excludeFiles": [
        "apps/web/composition/server.ts",
        "apps/web/composition/server/**",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)apps/server/|^(?:\\.\\./)+server/src(?:/|$)|^@weng-lab/mcp(?:/|$)",
                "message": "Web and MCP communicate through contracts, never through each other's source."
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "drizzle-kit",
                  "drizzle-kit/**",
                  "pg",
                  "pg/**"
                ],
                "message": "Database access belongs in feature server modules and server composition."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/features/**/server/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)apps/server/|^(?:\\.\\./)+server/src(?:/|$)|^@weng-lab/mcp(?:/|$)",
                "message": "Web and MCP communicate through contracts, never through each other's source."
              },
              {
                "regex": "(?:^|/)(?:app|composition)(?:/|$)",
                "message": "Features expose capabilities to routes and composition; they must not import those callers."
              }
            ]
          }
        ]
      }
    }
  ],
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  }
}
