{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "CI",
    "NEXT_TELEMETRY_DISABLED",
    "DATABASE_URL",
    "REDIS_URL",
    "GB_IDENTITY",
    "CLERK_SECRET_KEY",
    "CLERK_JWT_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "PORT",
    "AI_GATEWAY_API_KEY"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "node_modules/.tmp/**",
        "tsconfig.tsbuildinfo"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": ["NEXT_PUBLIC_MUI_X_LICENSE_KEY", "VITE_MUI_X_LICENSE_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["node_modules/.tmp/**", "tsconfig.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["transit", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "//#format:root": {
      "cache": false
    },
    "//#format:check:root": {},
    "//#lint:policy": {
      "inputs": ["tools/lint/**", ".oxlintrc.json", "package.json", "pnpm-lock.yaml"]
    },
    "@weng-lab/web#build": {
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".output/**",
        ".eve/agent-summary.json"
      ]
    }
  }
}
