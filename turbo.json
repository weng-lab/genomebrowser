{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "CI",
    "NEXT_TELEMETRY_DISABLED",
    "GB_SERVER_URL",
    "GB_DATABASE_PATH",
    "GB_SERVER_HOST",
    "GB_SERVER_PORT",
    "GB_ALLOWED_ORIGINS",
    "PORT"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "node_modules/.tmp/**",
        "tsconfig.tsbuildinfo"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": ["NEXT_PUBLIC_MUI_X_LICENSE_KEY", "VITE_MUI_X_LICENSE_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["node_modules/.tmp/**", "tsconfig.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "//#format:root": {
      "cache": false
    },
    "//#format:check:root": {}
  }
}
