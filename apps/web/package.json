{
  "name": "@weng-lab/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "eve build && next build",
    "start": "next start --hostname localhost",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "db:start": "docker compose up --detach --wait",
    "db:stop": "docker compose stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "sessions:import-sqlite": "node --env-file-if-exists=.env.local scripts/importSqliteSessions.ts"
  },
  "dependencies": {
    "@clerk/mcp-tools": "^0.8.0",
    "@clerk/nextjs": "^7.9.17",
    "@emotion/cache": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@google-cloud/cloud-sql-connector": "^1.12.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "@mui/material-nextjs": "catalog:",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@vercel/functions": "^3.10.3",
    "@vercel/oidc": "^4.0.3",
    "@weng-lab/genomebrowser": "workspace:*",
    "@weng-lab/genomebrowser-tracks": "workspace:*",
    "@weng-lab/genomebrowser-ui": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.5",
    "eve": "1.0.0-rc.1",
    "google-auth-library": "^11.3.1",
    "next": "catalog:",
    "pg": "^8.23.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "redis": "^6.3.1",
    "server-only": "^0.0.1",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@next/env": "16.3.3",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@weng-lab/render-probe": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "jsdom": "catalog:",
    "just-bash": "^3.6.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:native",
    "vitest": "catalog:"
  }
}
