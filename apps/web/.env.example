# Eve prefers this server-only Vercel AI Gateway key when configured.
# Set it in Vercel Preview/Production environments; locally, omit it to use `codex login`.
# AI_GATEWAY_API_KEY=

# Saved-session database, used only by the Next.js server. This matches compose.yaml.
DATABASE_URL=postgres://genomebrowser:genomebrowser@127.0.0.1:5432/genomebrowser

# Delivers agent commands to browser tabs. This matches compose.yaml.
REDIS_URL=redis://127.0.0.1:6379

# Cloud SQL instead of DATABASE_URL. Outside Vercel, uses Google application default credentials.
# INSTANCE_CONNECTION_NAME=<project>:<region>:<instance>
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# On Vercel, Google access through Workload Identity Federation with the deployment's OIDC token.
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=

# Use real Clerk sign-ins locally and in deployments.
GB_IDENTITY=clerk
# For local development, use the same Clerk development instance as Preview.
# Copy its sk_test_ and pk_test_ keys here; production uses its own instance.
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional PEM public key. Clerk then verifies session tokens without fetching its keys.
# CLERK_JWT_KEY=

# For offline development, opt in to local mock users with GB_IDENTITY=mock.
# Mock identity is refused in production builds.

# Server for the database tests. Each run creates and drops its own database.
# GB_TEST_DATABASE_URL=postgres://genomebrowser:genomebrowser@127.0.0.1:5432/postgres
# Server for the agent command tests. Each run uses its own keys.
# GB_TEST_REDIS_URL=redis://127.0.0.1:6379

# Optional comma-separated hostnames allowed to load Next.js dev assets through a private proxy.
# GB_DEV_HOSTS=your-machine.your-tailnet.ts.net

# Opt in to Eve access through an authenticated private development proxy. Exact origins only.
# GB_AGENT_DEV_ORIGINS=https://your-machine.your-tailnet.ts.net:8443
