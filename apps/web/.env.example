# Optional loopback MCP server. Saved sessions use Next.js routes, not this server.
GB_SERVER_URL=http://127.0.0.1:3001

# Saved-session database, used only by the Next.js server. This matches compose.yaml.
DATABASE_URL=postgres://genomebrowser:genomebrowser@127.0.0.1:5432/genomebrowser

# Cloud SQL instead of DATABASE_URL. Outside Vercel, uses Google application default credentials.
# INSTANCE_CONNECTION_NAME=<project>:<region>:<instance>
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# On Vercel, Google access through Workload Identity Federation with the deployment's OIDC token.
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=

# Clerk accounts, required. Locally, use the development instance's pk_test_ and sk_test_
# keys, the same instance as Vercel Preview. Requests fail without them.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional PEM public key. Clerk then verifies session tokens without fetching its keys.
# CLERK_JWT_KEY=

# Server for the database tests. Each run creates and drops its own database.
# GB_TEST_DATABASE_URL=postgres://genomebrowser:genomebrowser@127.0.0.1:5432/postgres
