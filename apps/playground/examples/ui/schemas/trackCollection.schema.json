{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "assembly": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "views": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "hidden": {
                  "type": "boolean"
                }
              },
              "required": ["field"],
              "additionalProperties": false
            }
          },
          "grouping": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "leaf": {
            "default": "title",
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "label", "columns"],
        "additionalProperties": false
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "base": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "display": {
                    "default": "full",
                    "type": "string",
                    "enum": ["full", "dense"]
                  },
                  "height": {
                    "default": 80,
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "color": {
                    "default": "#2266aa",
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  }
                },
                "required": ["id", "title"],
                "additionalProperties": false
              },
              "config": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fillWithZero": {
                    "default": false,
                    "type": "boolean"
                  },
                  "yRange": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    }
                  },
                  "showClampIndicators": {
                    "default": true,
                    "type": "boolean"
                  },
                  "clampIndicatorColor": {
                    "default": "#ff0000",
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  }
                },
                "required": ["url"],
                "additionalProperties": false
              },
              "type": {
                "type": "string",
                "const": "bigwig"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["base", "config", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "base": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "display": {
                    "default": "dense",
                    "type": "string",
                    "enum": ["dense", "squish"]
                  },
                  "height": {
                    "default": 12,
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "color": {
                    "default": "#4b9560",
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  }
                },
                "required": ["id", "title"],
                "additionalProperties": false
              },
              "config": {
                "type": "object",
                "properties": {
                  "bedSchema": {
                    "type": "string",
                    "enum": ["bed3", "bed4", "bed5", "bed6", "bed9", "ccre"]
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rowHeight": {
                    "default": 12,
                    "type": "number",
                    "minimum": 1
                  }
                },
                "required": ["url"],
                "additionalProperties": false
              },
              "type": {
                "type": "string",
                "const": "bigbed"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["base", "config", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "base": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "display": {
                    "default": "split",
                    "type": "string",
                    "enum": ["split"]
                  },
                  "height": {
                    "default": 100,
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "color": {
                    "default": "#000000",
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  }
                },
                "required": ["id", "title"],
                "additionalProperties": false
              },
              "config": {
                "type": "object",
                "properties": {
                  "urls": {
                    "type": "object",
                    "properties": {
                      "plusStrand": {
                        "type": "object",
                        "properties": {
                          "cpg": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["url"]
                          },
                          "chg": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["url"]
                          },
                          "chh": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["url"]
                          },
                          "depth": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["url"]
                          }
                        },
                        "required": ["cpg", "chg", "chh", "depth"]
                      },
                      "minusStrand": {
                        "type": "object",
                        "properties": {
                          "cpg": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["url"]
                          },
                          "chg": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["url"]
                          },
                          "chh": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["url"]
                          },
                          "depth": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["url"]
                          }
                        },
                        "required": ["cpg", "chg", "chh", "depth"]
                      }
                    },
                    "required": ["plusStrand", "minusStrand"]
                  },
                  "colors": {
                    "default": {
                      "cpg": "#648bd8",
                      "chg": "#ff944d",
                      "chh": "#ff00ff",
                      "depth": "#525252"
                    },
                    "type": "object",
                    "properties": {
                      "cpg": {
                        "default": "#648bd8",
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "chg": {
                        "default": "#ff944d",
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "chh": {
                        "default": "#ff00ff",
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "depth": {
                        "default": "#525252",
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      }
                    }
                  },
                  "maskCpgByCoverage": {
                    "default": false,
                    "type": "boolean"
                  },
                  "range": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": ["min", "max"]
                  }
                },
                "required": ["urls"],
                "additionalProperties": false
              },
              "type": {
                "type": "string",
                "const": "methylc"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["base", "config", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "base": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "display": {
                    "default": "squish",
                    "type": "string",
                    "enum": ["squish", "pack"]
                  },
                  "height": {
                    "default": 90,
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "color": {
                    "default": "#7a4fb3",
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  }
                },
                "required": ["id", "title"],
                "additionalProperties": false
              },
              "config": {
                "type": "object",
                "properties": {
                  "endpoint": {
                    "default": "/api/screen-graphql",
                    "type": "string",
                    "minLength": 1
                  },
                  "assembly": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "geneName": {
                    "type": "string"
                  },
                  "canonicalColor": {
                    "default": "#000000",
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  },
                  "highlightColor": {
                    "default": "#000000",
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  },
                  "rowHeight": {
                    "default": 12,
                    "type": "number",
                    "minimum": 1
                  }
                },
                "required": ["assembly", "version"],
                "additionalProperties": false
              },
              "type": {
                "type": "string",
                "const": "transcript"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["base", "config", "type"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["assembly", "id", "tracks"],
  "additionalProperties": false
}
