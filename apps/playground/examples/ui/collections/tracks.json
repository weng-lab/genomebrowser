{
  "assembly": "hg38",
  "$schema": "../schemas/trackCollection.schema.json",
  "id": "test-tracks",
  "label": "Test Tracks",
  "description": "Small test collection for Track Select JSON loading.",
  "views": [
    {
      "id": "default",
      "label": "Default",
      "columns": [
        {
          "field": "trackType",
          "label": "Track Type"
        },
        {
          "field": "source",
          "label": "Source"
        }
      ],
      "grouping": ["trackType"],
      "leaf": "title"
    },
    {
      "id": "source",
      "label": "source",
      "columns": [
        {
          "field": "trackType",
          "label": "Track Type"
        },
        {
          "field": "source",
          "label": "Source"
        }
      ],
      "description": "description",
      "grouping": ["source"],
      "leaf": "title"
    }
  ],
  "tracks": [
    {
      "type": "bigwig",
      "base": {
        "id": "odnasd",
        "title": "DNase aggregate",
        "height": 50,
        "color": "#1B2021"
      },
      "config": {
        "url": "https://downloads.wenglab.org/DNAse_All_ENCODE_MAR20_2024_merged.bw"
      },
      "metadata": {
        "trackType": "BigWig",
        "source": "ENCODE"
      }
    },
    {
      "type": "bigbed",
      "base": {
        "id": "example-bigbed",
        "title": "Example BigBed",
        "height": 60,
        "color": "#4b9560"
      },
      "config": {
        "url": "YOUR_URL_HERE"
      },
      "metadata": {
        "trackType": "BigBed",
        "source": "Example"
      }
    }
  ]
}
