# Optional authentication. Leave both empty to run with public browsing only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Gene, SNP, and cCRE search. Coordinate search works without this key.
SCREEN_API_KEY=

# MUI X Premium license for the track selector.
NEXT_PUBLIC_MUI_X_LICENSE_KEY=

# Server-only PostgreSQL connection for local development and migrations.
# For the Cloud SQL Auth Proxy, use its local address and port in this URL.
DATABASE_URL=
# Local Docker database password. Use the same password in DATABASE_URL.
# Local host: 127.0.0.1:55432, user/database: genomebrowser.
POSTGRES_PASSWORD=

# Cloud SQL runtime connection. When set, this takes precedence over DATABASE_URL.
# Leave empty locally to continue using DATABASE_URL through your proxy or Docker.
INSTANCE_CONNECTION_NAME=
DB_NAME=
DB_USER=
# Original PostgreSQL password, not URL-encoded.
DB_PASSWORD=

# Required for Cloud SQL on Vercel; outside Vercel the connector uses Google ADC.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
