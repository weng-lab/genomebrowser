# Optional authentication. Leave both empty to run with public browsing only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Gene, SNP, and cCRE search. Coordinate search works without this key.
SCREEN_API_KEY=

# MUI X Premium license for the track selector.
NEXT_PUBLIC_MUI_X_LICENSE_KEY=

# Server-only PostgreSQL connection for saved sessions.
DATABASE_URL=
# Local Docker database password. Use the same password in DATABASE_URL.
# Local host: 127.0.0.1:55432, user/database: genomebrowser.
POSTGRES_PASSWORD=
