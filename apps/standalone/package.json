{
  "name": "@weng-lab/genomebrowser-standalone",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:down": "docker compose --env-file .env.local stop"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.5",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "@mui/material-nextjs": "7.3.10",
    "@mui/x-license": "catalog:",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "@vercel/oidc": "^3.8.9",
    "@weng-lab/genomebrowser": "workspace:*",
    "@weng-lab/genomebrowser-tracks": "workspace:*",
    "@weng-lab/genomebrowser-ui": "workspace:*",
    "@weng-lab/genomic-reader": "workspace:*",
    "@weng-lab/ui-components": "catalog:",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.3",
    "google-auth-library": "^11.1.0",
    "next": "catalog:",
    "pg": "^8.23.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.11",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:native",
    "vitest": "catalog:"
  }
}
