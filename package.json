{
  "name": "@weng-lab/genomebrowser-monorepo",
  "private": true,
  "scripts": {
    "core": "pnpm --filter @weng-lab/genomebrowser",
    "ui": "pnpm --filter @weng-lab/genomebrowser-ui",
    "app": "pnpm --filter @weng-lab/genomebrowser-app",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "oxfmt package.json pnpm-workspace.yaml CONTRIBUTING.md README.md .github && pnpm -r format",
    "format:check": "oxfmt package.json pnpm-workspace.yaml CONTRIBUTING.md README.md .github --check && pnpm -r format:check",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "doctor": "pnpm exec react-doctor . --verbose",
    "publish:dry-run": "pnpm publish -r --tag alpha --dry-run --no-git-checks",
    "publish:alpha": "pnpm publish -r --tag alpha"
  },
  "devDependencies": {
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "react-doctor": "^0.7.8"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce"
}
