{
  "name": "@weng-lab/genomebrowser-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @weng-lab/genomebrowser build",
    "build:app": "pnpm --filter @weng-lab/genomebrowser-app build",
    "build:ui": "pnpm --filter @weng-lab/genomebrowser-ui build",
    "dev": "pnpm --parallel -r dev",
    "dev:core": "pnpm --filter @weng-lab/genomebrowser dev",
    "dev:app": "pnpm --filter @weng-lab/genomebrowser-app dev",
    "dev:ui": "pnpm --filter @weng-lab/genomebrowser-ui dev",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @weng-lab/genomebrowser test",
    "test:ui": "pnpm --filter @weng-lab/genomebrowser-ui test",
    "lint": "pnpm -r lint",
    "lint:core": "pnpm --filter @weng-lab/genomebrowser lint",
    "lint:ui": "pnpm --filter @weng-lab/genomebrowser-ui lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:core": "pnpm --filter @weng-lab/genomebrowser format",
    "format:ui": "pnpm --filter @weng-lab/genomebrowser-ui format",
    "format:check": "pnpm -r format:check",
    "format:check:core": "pnpm --filter @weng-lab/genomebrowser format:check",
    "format:check:ui": "pnpm --filter @weng-lab/genomebrowser-ui format:check",
    "doctor": "pnpm exec react-doctor . --verbose",
    "publish:dry-run": "pnpm publish -r --tag alpha --dry-run --no-git-checks",
    "publish:alpha": "pnpm publish -r --tag alpha"
  },
  "devDependencies": {
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "react-doctor": "^0.7.8"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce"
}
