{
  "name": "@weng-lab/genomebrowser-monorepo",
  "private": true,
  "scripts": {
    "core": "pnpm --filter @weng-lab/genomebrowser",
    "tracks": "pnpm --filter @weng-lab/genomebrowser-tracks",
    "ui": "pnpm --filter @weng-lab/genomebrowser-ui",
    "standalone": "pnpm --filter @weng-lab/genomebrowser-standalone",
    "playground": "pnpm --filter @weng-lab/genomebrowser-playground",
    "reader": "pnpm --filter @weng-lab/genomic-reader",
    "dev": "pnpm --filter @weng-lab/genomebrowser-playground dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format //#format:root",
    "format:root": "oxfmt package.json pnpm-workspace.yaml turbo.json AGENTS.md README.md .github",
    "format:check": "turbo run format:check //#format:check:root",
    "format:check:root": "oxfmt package.json pnpm-workspace.yaml turbo.json AGENTS.md README.md .github --check",
    "verify": "turbo run format:check lint build test //#format:check:root",
    "doctor": "pnpm exec react-doctor . --verbose",
    "publish:dry-run": "pnpm publish -r --tag latest --dry-run --no-git-checks",
    "publish:stable": "pnpm publish -r --tag latest",
    "test:browser": "turbo run test:e2e --filter=@weng-lab/genomebrowser-browser-tests",
    "browser": "pnpm --filter @weng-lab/genomebrowser-browser-tests",
    "browser:dev": "turbo run dev --filter=@weng-lab/genomebrowser-browser-tests"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react-doctor": "^0.9.14",
    "turbo": "2.10.11"
  },
  "packageManager": "pnpm@12.4.2"
}
