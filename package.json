{
  "name": "@weng-lab/genomebrowser-monorepo",
  "private": true,
  "scripts": {
    "core": "pnpm --filter @weng-lab/genomebrowser",
    "tracks": "pnpm --filter @weng-lab/genomebrowser-tracks",
    "ui": "pnpm --filter @weng-lab/genomebrowser-ui",
    "reader": "pnpm --filter @weng-lab/genomic-reader",
    "web": "pnpm --filter @weng-lab/web",
    "server": "pnpm --filter @weng-lab/mcp",
    "dev": "turbo run dev --filter=@weng-lab/web --filter=@weng-lab/mcp",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint //#lint:policy",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format //#format:root",
    "format:root": "oxfmt package.json pnpm-workspace.yaml turbo.json AGENTS.md README.md .github tools/lint",
    "format:check": "turbo run format:check //#format:check:root",
    "format:check:root": "oxfmt package.json pnpm-workspace.yaml turbo.json AGENTS.md README.md .github tools/lint --check",
    "verify": "turbo run format:check lint //#lint:policy build test //#format:check:root",
    "doctor": "pnpm exec react-doctor . --verbose",
    "publish:dry-run": "pnpm publish -r --tag latest --dry-run --no-git-checks",
    "publish:stable": "pnpm publish -r --tag latest",
    "dev:web": "turbo run dev --filter=@weng-lab/web",
    "dev:server": "turbo run dev --filter=@weng-lab/mcp",
    "lint:policy": "node --test tools/lint/policy.test.mjs"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "7.0.2004",
    "react-doctor": "^0.9.14",
    "turbo": "2.11.7"
  },
  "packageManager": "pnpm@12.4.2"
}
