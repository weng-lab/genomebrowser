{
  "name": "@weng-lab/render-probe",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic React render counts for tests.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./setup": "./src/setup.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "bippy": "0.7.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:native",
    "vitest": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "knip": {
    "entry": [
      "src/index.ts",
      "src/setup.ts"
    ]
  }
}
