{
  "name": "@weng-lab/genomebrowser-ui",
  "version": "2.0.0-alpha.1",
  "description": "Optional React application controls for @weng-lab/genomebrowser.",
  "homepage": "https://github.com/weng-lab/genomebrowser#readme",
  "bugs": {
    "url": "https://github.com/weng-lab/genomebrowser/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weng-lab/genomebrowser.git",
    "directory": "packages/ui"
  },
  "bin": {
    "trackselect": "dist/trackselect.js"
  },
  "files": [
    "dist",
    "docs",
    "schemas",
    "LICENSE"
  ],
  "type": "module",
  "module": "dist/genomebrowser-ui.es.js",
  "types": "dist/src/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/lib.d.ts",
      "import": "./dist/genomebrowser-ui.es.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "preview": "vite preview",
    "prepack": "pnpm --filter @weng-lab/genomebrowser build && pnpm build"
  },
  "dependencies": {
    "@weng-lab/genomebrowser": "workspace:^2.0.0-alpha.0",
    "jiti": "^2.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/x-data-grid-premium": "^8.0.0",
    "@mui/x-license": "^8.0.0",
    "@mui/x-tree-view": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
