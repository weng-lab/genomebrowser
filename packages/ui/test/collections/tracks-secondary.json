{
  "$schema": "../schemas/trackSelectCollection.schema.json",
  "id": "secondary-test-tracks",
  "label": "Secondary Test Tracks",
  "description": "Second test collection for checking Track Select collection navigation.",
  "views": [
    {
      "id": "default",
      "label": "Default",
      "columns": [
        {
          "field": "trackType",
          "label": "Track Type"
        },
        {
          "field": "source",
          "label": "Source"
        }
      ],
      "grouping": ["trackType"],
      "leaf": "title"
    },
    {
      "id": "source",
      "label": "source",
      "columns": [
        {
          "field": "trackType",
          "label": "Track Type"
        },
        {
          "field": "source",
          "label": "Source"
        }
      ],
      "description": "description",
      "grouping": ["source"],
      "leaf": "title"
    }
  ],
  "tracks": [
    {
      "type": "bigwig",
      "id": "secondary-odnasd",
      "title": "Secondary DNase aggregate",
      "color": "#1B2021",
      "height": 50,
      "config": {
        "url": "https://downloads.wenglab.org/DNAse_All_ENCODE_MAR20_2024_merged.bw"
      },
      "metadata": {
        "trackType": "BigWig",
        "source": "ENCODE"
      }
    },
    {
      "type": "bigbed",
      "id": "secondary-example-bigbed",
      "title": "Secondary Example BigBed",
      "color": "#4b9560",
      "height": 60,
      "config": {
        "url": "YOUR_URL_HERE"
      },
      "metadata": {
        "trackType": "BigBed",
        "source": "Example"
      }
    }
  ]
}
