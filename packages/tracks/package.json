{
  "name": "@weng-lab/genomebrowser-tracks",
  "version": "2.0.0",
  "description": "First-party track modules for @weng-lab/genomebrowser.",
  "homepage": "https://github.com/weng-lab/genomebrowser#readme",
  "bugs": {
    "url": "https://github.com/weng-lab/genomebrowser/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weng-lab/genomebrowser.git",
    "directory": "packages/tracks"
  },
  "files": [
    "dist",
    "docs",
    "schemas",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "dist/genomebrowser-tracks.es.js",
  "types": "dist/src/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/lib.d.ts",
      "import": "./dist/genomebrowser-tracks.es.js"
    },
    "./bigbed": {
      "types": "./dist/src/bigbed/index.d.ts",
      "import": "./dist/bigbed.js"
    },
    "./bigwig": {
      "types": "./dist/src/bigwig/index.d.ts",
      "import": "./dist/bigwig.js"
    },
    "./bulkbed": {
      "types": "./dist/src/bulkbed/index.d.ts",
      "import": "./dist/bulkbed.js"
    },
    "./cave": {
      "types": "./dist/src/cave/index.d.ts",
      "import": "./dist/cave.js"
    },
    "./ccre": {
      "types": "./dist/src/ccre/index.d.ts",
      "import": "./dist/ccre.js"
    },
    "./gene": {
      "types": "./dist/src/gene/index.d.ts",
      "import": "./dist/gene.js"
    },
    "./methylc": {
      "types": "./dist/src/methylc/index.d.ts",
      "import": "./dist/methylc.js"
    },
    "./shared": {
      "types": "./dist/src/shared/index.d.ts",
      "import": "./dist/shared.js"
    },
    "./ruler": {
      "types": "./dist/src/ruler/index.d.ts",
      "import": "./dist/ruler.js"
    },
    "./trackCollection.schema.json": "./schemas/trackCollection.schema.json",
    "./bam": {
      "types": "./dist/src/bam/index.d.ts",
      "import": "./dist/bam.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "vite build && node scripts/verify-package.mjs",
    "build:checked": "pnpm typecheck && pnpm build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "verify:package": "pnpm build:checked",
    "prepack": "pnpm --filter @weng-lab/genomebrowser build:checked && pnpm --filter @weng-lab/genomic-reader build:checked && pnpm build:checked"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@weng-lab/genomic-reader": "workspace:^2.0.0",
    "react-colorful": "^5.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@weng-lab/genomebrowser": "workspace:^2.0.0",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^7.0.0",
    "@weng-lab/genomebrowser": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
