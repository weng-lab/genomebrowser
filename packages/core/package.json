{
  "name": "@weng-lab/genomebrowser",
  "version": "2.0.0-alpha.1",
  "description": "An extensible React runtime for displaying genomic tracks.",
  "homepage": "https://github.com/weng-lab/genomebrowser#readme",
  "bugs": {
    "url": "https://github.com/weng-lab/genomebrowser/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weng-lab/genomebrowser.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "type": "module",
  "module": "dist/genomebrowser.es.js",
  "types": "dist/src/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/lib.d.ts",
      "import": "./dist/genomebrowser.es.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "preview": "vite preview",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "axios": "0.33.0",
    "buffer": "^6.0.3",
    "genomic-reader": "^1.4.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
