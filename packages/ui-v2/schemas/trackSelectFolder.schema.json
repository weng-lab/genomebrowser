{
  "$id": "https://weng-lab.github.io/genomebrowser/schemas/trackSelectFolder.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "views": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "hidden": {
                  "type": "boolean"
                }
              },
              "required": [
                "field"
              ],
              "additionalProperties": false
            }
          },
          "grouping": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "leaf": {
            "default": "title",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "columns"
        ],
        "additionalProperties": false
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "display": {
                "type": "string",
                "minLength": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "color": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": {}
          },
          "metadata": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "type",
          "config"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "label",
    "views",
    "tracks"
  ],
  "additionalProperties": false
}
